# Copy via: python -m backend.app.cli init
# The init command creates a private .env with random admin/encryption keys.

MERGEMIND_ADMIN_TOKEN=
MERGEMIND_ENCRYPTION_KEY=
MERGEMIND_DATABASE_PATH=data/mergemind.sqlite3

# Default local model endpoint (free, requires Ollama and the model pulled)
MERGEMIND_LLM_BASE_URL=http://127.0.0.1:11434/v1
MERGEMIND_LLM_API_KEY=ollama
MERGEMIND_LLM_MODEL=qwen2.5-coder:3b
MERGEMIND_LLM_TIMEOUT_SECONDS=120

MERGEMIND_SWITCH_RECONNECT_SECONDS=5
